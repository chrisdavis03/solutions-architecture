# macOS Finder metadata
.DS_Store

# Windows Explorer thumbnail cache
Thumbs.db

# Editor and IDE settings
.idea/
.vscode/

# Diagram render output (generated, not source)
diagrams/.render/

# Scratch and temporary files
*.tmp

# Terraform local state, plugins and plan files (never commit state or plans)
.terraform/
*.tfstate
*.tfstate.*
tfplan*
# Real variable values (may hold domain names or account data). Exact name only:
# terraform.tfvars.example must stay tracked.
terraform.tfvars

# Python bytecode, test caches and virtual environments
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Build output (packaged Lambda zips, etc.)
.build/

# Local agent workflow state (handoff file stays on disk, never committed)
.opencode/

# Provider lock files are regenerated by `tofu init`; keep them out of this demo repo
.terraform.lock.hcl
